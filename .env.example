# MailerLite – newsletter
# Uzyskaj klucz API: MailerLite → Settings → API → Developer API
MAILERLITE_API_KEY=your_mailerlite_api_key_here

# ID grupy subskrybentów: MailerLite → Subscribers → Groups → kliknij grupę → ID w URL
MAILERLITE_GROUP_ID=your_mailerlite_group_id_here

# Recraft – generowanie line-artu (scripts/lineart-generate.mjs)
# Klucz: panel Recrafta → API. NIGDY nie wklejaj go do czatu ani do commita.
RECRAFT_API_TOKEN=your_recraft_api_token_here

# fal.ai – alternatywny silnik (Flux) do porównania
FAL_KEY=your_fal_key_here

# Pinterest – automatyczna publikacja pinów (scripts/pinterest/)
# developers.pinterest.com → My apps → aplikacja → App ID i App secret.
# Jednorazowo: node scripts/pinterest/auth.mjs → zapisuje .pinterest-token.json (w .gitignore)
# i wypisuje refresh token do sekretów GitHub Actions (workflow pinterest-daily).
PINTEREST_APP_ID=your_pinterest_app_id_here
PINTEREST_APP_SECRET=your_pinterest_app_secret_here

# DataForSEO – warsztat do szukania fraz (scripts/dfs/)
# Panel DataForSEO → API Dashboard. UWAGA: hasło API to NIE jest hasło do logowania
# na stronie, tylko osobna wartość generowana dla API.
# Rozliczenie jest za pojedyncze zapytanie, więc każdy przebieg kosztuje realne pieniądze
# – skrypty wypisują koszt po każdym wywołaniu.
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_api_password_here
