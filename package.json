    "@nuxtjs/tailwindcss": "6.14.0",
    "@vueuse/nuxt": "13.1.0",
    "fuse.js": "^7.1.0",
    "klaro": "^0.7.21",
    "nuxt": "^3.14.1592",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "npm:@nuxtjs/tailwindcss@nightly",
    "@zadigetvoltaire/nuxt-gtm": "^0.0.13",
    "nuxt-disqus": "^1.2.0",
