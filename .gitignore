# Materiał roboczy wymiany grafik (surowe generacje, arkusze przeglądowe).
# Wyjątek: katalogi `ok/` z wyselekcjonowanymi ręcznie SVG trzymamy w repo — to jedyny
# etap pipeline'u, którego nie da się odtworzyć bez ponownego generowania i ponownej
# selekcji na oko. Odrzuty, arkusze kontaktowe PNG i katalogi testowe zostają lokalnie.
#
# Wzorzec musi być `lineart-work/**`, a nie `lineart-work/`: git nie wchodzi do katalogu
# wykluczonego jako całość, więc przy `lineart-work/` żaden `!` w środku by nie zadziałał.
# Kolejne `!` na katalogach są potrzebne tylko po to, żeby git zszedł na czwarty poziom.
lineart-work/**
!lineart-work/*/
!lineart-work/*/*/
!lineart-work/*/*/ok/
!lineart-work/*/*/ok/*.svg

# Katalogi `out-*` to wynik wektoryzacji, a nie ręcznej selekcji — bywają kopiowane
# pod ścieżki kończące się na `ok/` i wtedy wpadały pod wyjątek wyżej, dublując pliki
# już będące w repo. Trzymamy je poza gitem; to, co wybrane, i tak ląduje w public/.
lineart-work/*/out-*/

# `_wybor.txt` to czysta decyzja człowieka: kilkanaście kilobajtów, których nie da się
# odtworzyć ani wygenerować ponownie. Najcenniejszy plik w całym katalogu roboczym.
!lineart-work/*/_wybor.txt

# Certyfikaty licencyjne Magnific/Freepik — zawierają dane osobowe
license-*.pdf

# Sitemapa obrazów — w całości wyliczana z content/ przez scripts/sitemap-images.mjs,
# odpalana w `pnpm build` przed `nuxt generate`. Pół megabajta generowanego XML-a
# w historii repo nie wnosi nic, czego nie da się odtworzyć jedną komendą.
public/sitemap-images.xml

# Local Netlify folder
.netlify
